{
    "name": "pi-nop",
    "version": "0.1.0",
    "description": "Read-only subagents for pi: repo search, web fetch, npm package docs, web search, and a /plan panel.",
    "keywords": [
        "pi-package",
        "pi",
        "pi-extension",
        "pi-coding-agent",
        "pi.dev",
        "coding-agent",
        "ai-agent",
        "agent",
        "subagent",
        "read-only",
        "local-llm",
        "llm",
        "llama-server",
        "web-search",
        "web-fetch",
        "npm-docs",
        "planning"
    ],
    "license": "MIT",
    "author": "Edgars Mjasnikovs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mjasnikovs/pi-nop.git"
    },
    "homepage": "https://github.com/mjasnikovs/pi-nop#readme",
    "bugs": {
        "url": "https://github.com/mjasnikovs/pi-nop/issues"
    },
    "type": "module",
    "module": "./src/index.ts",
    "files": [
        "src",
        "README.md",
        "LICENSE",
        "assets"
    ],
    "scripts": {
        "test": "bun test",
        "lint": "prettier --log-level warn --write '{src,test,eval}/**/*.ts' && eslint --fix . && tsc --noEmit",
        "lint:check": "prettier --check '{src,test,eval}/**/*.ts' && eslint . --max-warnings 0 && tsc --noEmit",
        "eval": "bun eval/fetch.eval.ts",
        "eval:search": "bun eval/search.eval.ts",
        "eval:docs": "bun eval/docs.eval.ts"
    },
    "dependencies": {
        "@mozilla/readability": "0.6.0",
        "linkedom": "0.18.13",
        "turndown": "7.2.4",
        "turndown-plugin-gfm": "1.0.2",
        "typescript": "6.0.3"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "1.0.0",
        "@earendil-works/pi-ai": "1.0.0",
        "@earendil-works/pi-coding-agent": "1.0.0",
        "@earendil-works/pi-tui": "1.0.0",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/bun": "1.4.2",
        "@types/turndown": "5.0.6",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.12.0",
        "prettier": "3.9.8",
        "typebox": "1.3.27",
        "typescript-eslint": "8.70.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": "*",
        "@earendil-works/pi-ai": "*",
        "@earendil-works/pi-coding-agent": "*",
        "@earendil-works/pi-tui": "*",
        "typebox": "*"
    },
    "pi": {
        "extensions": [
            "./src/index.ts"
        ],
        "image": "https://raw.githubusercontent.com/mjasnikovs/pi-nop/master/assets/hero.png"
    }
}
