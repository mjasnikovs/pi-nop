{
    "name": "pi-nop",
    "version": "0.0.1",
    "type": "module",
    "module": "./src/index.ts",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "rm -rf dist && tsc -p tsconfig.build.json",
        "test": "bun test",
        "lint": "prettier --log-level warn --write '{src,test}/**/*.ts' && eslint --fix . && tsc --noEmit",
        "lint:check": "prettier --check '{src,test}/**/*.ts' && eslint . --max-warnings 0 && tsc --noEmit",
        "prepublishOnly": "bun run build"
    },
    "dependencies": {
        "@mozilla/readability": "0.6.0",
        "linkedom": "0.18.13",
        "turndown": "7.2.4",
        "turndown-plugin-gfm": "1.0.2",
        "typebox": "1.3.34"
    },
    "devDependencies": {
        "@earendil-works/pi-agent-core": "0.86.1",
        "@earendil-works/pi-ai": "0.86.1",
        "@earendil-works/pi-coding-agent": "0.86.1",
        "@earendil-works/pi-tui": "0.86.1",
        "@eslint/js": "10.0.1",
        "@stylistic/eslint-plugin": "5.10.0",
        "@types/bun": "1.4.2",
        "@types/turndown": "5.0.6",
        "eslint": "10.11.0",
        "eslint-config-prettier": "10.1.8",
        "globals": "17.12.0",
        "prettier": "3.9.8",
        "typescript": "6.0.3",
        "typescript-eslint": "8.70.0"
    },
    "peerDependencies": {
        "@earendil-works/pi-agent-core": ">=0.86.0",
        "@earendil-works/pi-ai": ">=0.86.0",
        "@earendil-works/pi-coding-agent": ">=0.86.0",
        "@earendil-works/pi-tui": ">=0.86.0",
        "typescript": "6.0.3"
    },
    "pi": {
        "extensions": [
            "./src/index.ts"
        ]
    }
}
